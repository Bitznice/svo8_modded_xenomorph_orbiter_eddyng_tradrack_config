	{% set tool = params.TOOL|default(0)|int %}
	{% set force_unload = params.FORCE_UNLOAD|default(0)|int %}
	MMU_HOME TOOL={tool} FORCE_UNLOAD={force_unload}

[gcode_macro MMU__STATUS]
gcode = MMU_STATUS

[gcode_macro MMU__MOTORS_OFF]
