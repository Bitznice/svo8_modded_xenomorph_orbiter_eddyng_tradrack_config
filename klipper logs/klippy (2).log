	MMU_CHECK_GATE ALL=1

[gcode_macro MMU_REMAP_TTG]
description = Alias for updated macro name of MMU_TTG_MAP
gcode = 
	MMU_TTG_MAP {rawparams}

[gcode_macro MMU_FORM_TIP]
