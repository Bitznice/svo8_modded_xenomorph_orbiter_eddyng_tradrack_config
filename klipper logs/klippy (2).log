	{% set tool = params.TOOL|default(0)|int %}
	MMU_SELECT TOOL={tool}

[gcode_macro MMU__SELECT_BYPASS]
gcode = MMU_SELECT_BYPASS

[gcode_macro MMU__LOAD_BYPASS]
